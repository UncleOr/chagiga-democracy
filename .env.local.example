# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server only, NEVER expose to the browser.
# Used by admin server actions and the settlement job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL (used for the OAuth redirect). e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails granted admin on first login (bootstrap).
# After first login you can also toggle admin from the panel.
ADMIN_EMAILS=or@42creative.co.il
